# Mot de passe pour se connecter au back office (/admin).
# À DÉFINIR obligatoirement avant toute mise en ligne : sans cette variable,
# un mot de passe par défaut ("poker-admin") est utilisé, ce qui n'est pas
# sûr en production.
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session admin.
# Optionnel en local, mais recommandé en production (chaîne aléatoire longue).
ADMIN_SESSION_SECRET=change-moi-aussi

# --- Base de données ---------------------------------------------------
# OBLIGATOIRE : chaîne de connexion Postgres. Les tables sont créées
# automatiquement au premier démarrage (aucune migration manuelle requise),
# et pré-remplies avec 3 tournois d'exemple si la base est vide.
#
# N'importe quel Postgres managé convient (plan gratuit suffisant) :
#   - Vercel Postgres : https://vercel.com/docs/storage/vercel-postgres
#   - Neon            : https://neon.tech
#   - Supabase        : https://supabase.com
# En local, vous pouvez aussi lancer `docker compose up -d` (voir
# docker-compose.yml) pour une base Postgres locale, ou installer Postgres
# directement. Avec le docker-compose.yml fourni, la chaîne de connexion est :
#   postgresql://poker:poker@localhost:5432/poker_tournaments
DATABASE_URL=postgresql://user:password@host:5432/database

# --- Notifications par email (inscriptions) --------------------------------
# Sans ces variables, les emails ne sont pas envoyés : l'inscription
# fonctionne quand même, un message est simplement écrit dans les logs du
# serveur pour vous prévenir qu'aucun email n'a été envoyé.

# Adresse qui reçoit une notification à chaque nouvelle inscription
# (récapitulatif complet : tournoi + informations de la personne inscrite).
ADMIN_EMAIL=organisateur@votre-club.fr

# Paramètres du serveur SMTP utilisé pour l'envoi (Gmail avec mot de passe
# d'application, OVH, Mailgun, Brevo/Sendinblue, etc. — n'importe quel
# fournisseur SMTP standard convient).
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
# SMTP_SECURE=true seulement si votre fournisseur exige le port 465 (SSL).
SMTP_SECURE=false
SMTP_USER=votre-compte-smtp
SMTP_PASSWORD=votre-mot-de-passe-smtp

# Adresse et nom affichés comme expéditeur des emails envoyés par l'appli.
MAIL_FROM="Le Registre <no-reply@votre-club.fr>"

